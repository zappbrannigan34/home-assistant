    'room_model': 'sensor.ventilation_zap_room_model',
    'safety_temp': 'sensor.ventilation_zap_safety_temperature',
    'thermal_cap': 'sensor.ventilation_zap_thermal_cap',
    'recommended': 'sensor.ventilation_recommended_position',
    'primary_temp': 'sensor.sensor_zap_temperature',
    'weather': 'weather.forecast_home_assistant',
    'cover': 'cover.ventilation_zap_group',
    'overloads': [
      'binary_sensor.drivent_zap_left_datchik_peregruzki',
      'binary_sensor.drivent_zap_back_datchik_peregruzki'
    ],
    'target_co2': 'input_number.ventilation_target_co2',
    'min_pos': 'input_number.ventilation_min_position',
    'max_pos': 'input_number.ventilation_max_position',
    'deadband': 'input_number.ventilation_deadband_ppm',
