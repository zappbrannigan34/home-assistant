    'co2_raw': 'sensor.sensor_eva_co2',
    'co2_filtered': 'sensor.ventilation_eva_co2_filtered',
    'co2_slope': 'sensor.ventilation_eva_co2_slope',
    'forecast_co2': 'sensor.ventilation_eva_forecast_co2_30m',
    'forecast_error': 'sensor.ventilation_eva_forecast_error_30m',
    'room_model': 'sensor.ventilation_eva_room_model',
    'safety_temp': 'sensor.ventilation_eva_safety_temperature',
    'thermal_cap': 'sensor.ventilation_eva_thermal_cap',
    'recommended': 'sensor.ventilation_eva_recommended_position',
    'primary_temp': 'sensor.sensor_eva_temperature',
    'weather': 'weather.forecast_home_assistant',
    'cover': 'cover.drivent_eva_driventokonnyi_privod',
